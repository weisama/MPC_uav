<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bench</name>
  <version>0.1.0</version>
  <description>
    ★ 台架夹具（不是飞行代码）：**假 mavros** + 脚本化动捕输入 + 故障注入时序。
    给"节点级测试"提供 seam 1 的另一半 —— 状态机里那些"实飞才会想到"的判据
    （/mavros/state 静默、时间戳倒退、电压跌落、服务不应答）真 SITL 无法注入，
    只能靠夹具按秒表注入。Phase 1/2/3 的所有节点级测试共用它。
  </description>
  <maintainer email="127371350+weisama@users.noreply.github.com">weisama</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- 夹具本身用 rclpy 直接收发；被谁的测试用，谁自己声明 test_depend -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>mavros_msgs</depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
